{
  "name": "@b2b/instagram-collector",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Отдельный браузерный сборщик публичных профилей Instagram. Chromium не может жить внутри API — сервис запускается в своём контейнере.",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "start": "tsx src/index.ts",
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@b2b/domain": "0.1.0",
    "dotenv": "^17.4.2",
    "fastify": "^5.6.1",
    "playwright": "^1.62.1",
    "zod": "^4.1.5"
  },
  "devDependencies": {
    "@types/node": "^24.3.0",
    "tsx": "^4.20.5",
    "typescript": "^5.9.2",
    "vitest": "^3.2.4"
  }
}
