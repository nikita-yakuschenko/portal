DATABASE_URL=postgresql://postgres:postgres@localhost:5436/b2b_portal
JWT_SECRET=change-me
PORT=4000
API_BASE_URL=http://localhost:4000
NEXT_PUBLIC_API_URL=http://localhost:4000
# Публичный site-runtime (Dokploy / npm run dev:site): APP_ROLE=site NEXT_PUBLIC_APP_ROLE=site
ADMIN_EMAIL=admin@avgst.local
ADMIN_PASSWORD=ChangeMe123!
ADMIN_FULL_NAME=AVGST Admin
PARTNER_EMAIL=partner@avgst.local
PARTNER_PASSWORD=ChangeMe123!
PARTNER_FULL_NAME=Демо Партнёр
PARTNER_COMPANY_NAME=Демо Дилер
PARTNER_REGION=Нижний Новгород

# Official Tilda site API (Settings → API integrations)
TILDA_PUBLIC_KEY=
TILDA_SECRET_KEY=

# Tilda Store API for house catalog products
# How to get storepartuid/recid: open catalog page on avgst.ru → DevTools → Network → getproductslist
TILDA_API_BASE=https://store.tildaapi.com/api/getproductslist/
TILDA_MODULAR_STOREPARTUID=
TILDA_MODULAR_RECID=
TILDA_PANEL_STOREPARTUID=
TILDA_PANEL_RECID=
TILDA_SITE_BASE_URL=https://avgst.ru

# Профили соцсетей в мокапе (см. README)
SOCIAL_PROFILE_TTL_MINUTES=20
SOCIAL_FETCH_TIMEOUT_MS=15000
SOCIAL_MEDIA_MAX_BYTES=8388608
INSTAGRAM_PROVIDER=auto
META_APP_ID=
META_APP_SECRET=
META_ACCESS_TOKEN=
META_IG_BUSINESS_ID=
INSTAGRAM_COLLECTOR_URL=
INSTAGRAM_COLLECTOR_TOKEN=
COLLECTOR_PROXY_URL=
COLLECTOR_PROXY_USERNAME=
COLLECTOR_PROXY_PASSWORD=

# Общий дилерский вход на время переезда с Tilda (один логин на всех)
DEALER_EMAIL=dealer@avgst.ru
DEALER_PASSWORD=

# Публичный URL кабинета — ссылки в письмах (логин, сброс пароля)
APP_PUBLIC_URL=https://b2b.avgst.ru

# SMTP Яндекс 360. Auth — ящик с паролем приложения; From — общий noreply
SMTP_HOST=smtp.yandex.ru
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=
SMTP_PASS=
SMTP_FROM=AVGST <noreply@avgst.ru>

# Object storage (Garage S3). Пусто → локальный каталог uploads/ (только для dev)
# В Dokploy portal compose: endpoint на внутренний DNS garage-приложения
S3_ENDPOINT=
S3_PUBLIC_ENDPOINT=
S3_REGION=garage
S3_BUCKET=b2b
S3_ACCESS_KEY=
S3_SECRET_KEY=
